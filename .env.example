# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model (lightweight, required for vector generation)
EMBEDDING_MODEL=nomic-embed-text

# LLM Model - choose based on your available RAM:
#   qwen2.5-coder:7b  -> needs ~4-5 GB RAM (best quality)
#   qwen2.5-coder:3b  -> needs ~2-3 GB RAM
#   qwen2.5-coder:1.5b -> needs ~1-2 GB RAM (low memory)
#   llama3.2:1b       -> needs ~1-2 GB RAM (very small)
#   phi3:mini         -> needs ~2-3 GB RAM
LLM_MODEL=qwen2.5-coder:7b

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Document Processing
DATA_DIR=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Set to true to wipe all vectors before re-ingesting
CLEAR_BEFORE_INGEST=false

# Number of chunks to retrieve per query (default: 10)
SEARCH_LIMIT=10

# Minimum similarity score (0-1) for retrieved chunks to be considered relevant.
# Chunks below this threshold are discarded and the LLM won't be called.
#   0.3 = lenient (more results, may include irrelevant ones)
#   0.5 = balanced (default)
#   0.7 = strict (only highly relevant results)
SCORE_THRESHOLD=0.5

# Chat UI
PORT=3000
